{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "bezhansalleh/filament-language-switch": "^4.0",
        "filament/filament": "^4.0",
        "laravel-lang/common": "^6.7",
        "laravel/framework": "^12.0",
        "laravel/tinker": "^2.10.1",
        "spatie/laravel-translatable": "^6.11"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^3.6",
        "fakerphp/faker": "^1.23",
        "friendsofphp/php-cs-fixer": "^3.93",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.27",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "nunomaduro/larastan": "^3.9",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5.3",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "check": [
            "@php artisan config:clear --ansi",
            "@php artisan about"
        ],
        "fix": [
            "./vendor/bin/pint"
        ],
        "ci-check:quick": [
            "@php -v",
            "composer validate --no-check-publish",
            "php -l app",
            "./vendor/bin/pint --test",
            "./vendor/bin/phpstan analyse app --memory-limit=1G --no-progress --level=1"
        ],
        "ci-check:full": [
            "composer install --no-interaction --prefer-dist",
            "@php artisan config:clear",
            "@php artisan package:discover --ansi",
            "./vendor/bin/pint --test",
            "./vendor/bin/phpstan analyse app --memory-limit=1G --no-progress",
            "@php artisan test --stop-on-failure"
        ],
        "check-local": [
            "composer install --no-interaction --prefer-dist",
            "./vendor/bin/pint",
            "composer check",
            "php artisan config:clear",
            "php artisan config:cache",
            "php artisan route:clear",
            "php artisan route:cache",
            "php artisan view:clear",
            "php artisan view:cache",
            "php artisan test"
        ],
        "check-all": [
            "composer install --no-interaction --prefer-dist",
            "./vendor/bin/pint",
            "composer check",
            "php artisan config:clear",
            "php artisan config:cache",
            "php artisan route:clear",
            "php artisan route:cache",
            "php artisan view:clear",
            "php artisan view:cache",
            "php artisan optimize",
            "php artisan test"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "platform": {
            "php": "8.5.4"
        },
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
